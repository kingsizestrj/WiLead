DATABASE_URL="postgresql://hotspot:hotspot@localhost:5432/hotspot"
# openssl rand -base64 32
AUTH_SECRET="troque-isto"
TZ="America/Sao_Paulo"

# Primeiro acesso ao painel (usado pelo seed)
ADMIN_EMAIL="admin@voltecautomacao.com.br"
ADMIN_PASSWORD="troque-isto"

# Chatwoot: todas as mensagens (inclusive o código) saem pela caixa de WhatsApp do Chatwoot
CHATWOOT_URL="https://chat.voltecautomacao.com.br"
CHATWOOT_API_TOKEN=""
CHATWOOT_ACCOUNT_ID="1"
# ID da caixa de entrada WhatsApp Cloud (Configurações → Caixas de entrada)
CHATWOOT_INBOX_ID=""
# Template aprovado na Meta, categoria Autenticação, com botão "copiar código"
WHATSAPP_OTP_TEMPLATE="codigo_wifi"
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
# Versão da Graph API usada no criador de templates
META_GRAPH_VERSION="v23.0"

# Número do WhatsApp da Voltec usado no botão da landing page do Verão (só no seed)
VOLTEC_WHATSAPP_NUMBER=""

# Desenvolvimento: imprime o código no log, não chama o Chatwoot nem o MikroTik
CHATWOOT_DRY_RUN="false"
HOTSPOT_DRY_RUN="false"

# Onde salvar imagens/vídeos enviados pelo painel
UPLOAD_DIR="./uploads"
