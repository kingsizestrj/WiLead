DATABASE_URL="postgresql://hotspot:hotspot@localhost:5432/hotspot"
# openssl rand -base64 32
AUTH_SECRET="troque-isto"
TZ="America/Sao_Paulo"

# Primeiro acesso ao painel (usado pelo seed)
ADMIN_EMAIL="admin@voltec.com.br"
ADMIN_PASSWORD="troque-isto"

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE="codigo_wifi"
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_API_VERSION="v23.0"
# false se o template de autenticação não tiver botão "copiar código"
WHATSAPP_TEMPLATE_HAS_BUTTON="true"

# Desenvolvimento: imprime o código no log e não chama o MikroTik
WHATSAPP_DRY_RUN="false"
HOTSPOT_DRY_RUN="false"

# Onde salvar imagens/vídeos enviados pelo painel
UPLOAD_DIR="./uploads"
